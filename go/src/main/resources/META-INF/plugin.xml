<idea-plugin>
  <id>dev.restudio.go</id>
  <name>ReStudio Go</name>
  <vendor>ReStudio</vendor>
  <description><![CDATA[
    Go support through gopls and Delve: code insight, run and debug gutter icons for
    <code>func main()</code> and test functions.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>
  <depends>dev.restudio.core</depends>
  <depends>org.jetbrains.plugins.textmate</depends>

  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="restudio.gopls"
            name="gopls (ReStudio)"
            factoryClass="dev.restudio.go.lsp.GoplsServerFactory"/>
    <fileNamePatternMapping patterns="*.go"
                            serverId="restudio.gopls"
                            languageId="go"/>
    <debugAdapterServer id="restudio.delve"
                        name="Delve (ReStudio)"
                        factoryClass="dev.restudio.go.debug.DelveDescriptorFactory"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="textmate"
                                    implementationClass="dev.restudio.go.run.GoLineMarkerProvider"/>
    <configurationType implementation="dev.restudio.go.run.GoApplicationConfigurationType"/>
    <configurationType implementation="dev.restudio.go.test.GoTestConfigurationType"/>
    <runConfigurationProducer implementation="dev.restudio.go.run.GoRunConfigurationProducer"/>
    <runConfigurationProducer implementation="dev.restudio.go.test.GoTestRunConfigurationProducer"/>
    <pluginAdvertiserSuppressor implementation="dev.restudio.go.ide.GoAdvertiserSuppressor"/>
    <postStartupActivity implementation="dev.restudio.go.project.GoModuleRootsActivity"/>
    <lang.importOptimizer language="textmate" implementationClass="dev.restudio.go.format.GoImportOptimizer"/>
    <actionOnSave implementation="dev.restudio.go.format.GoOrganizeImportsOnSave"/>
    <projectConfigurable parentId="language"
                         id="restudio.go.settings"
                         instance="dev.restudio.go.settings.GoSettingsConfigurable"
                         key="settings.name"
                         bundle="messages.GoBundle"/>
    <newProjectWizard.generator implementation="dev.restudio.go.wizard.GoNewProjectWizard"/>
  </extensions>

  <projectListeners>
    <listener class="dev.restudio.go.project.GoModuleFilesListener"
              topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </projectListeners>
</idea-plugin>
