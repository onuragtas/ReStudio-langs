<idea-plugin>
  <id>dev.restudio.core</id>
  <name>ReStudio Core</name>
  <vendor>ReStudio</vendor>
  <description><![CDATA[
    Shared code of the ReStudio language plugins: run and debug gutter icons, debug adapter launches through LSP4IJ,
    and the test tree for external test runners.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>

  <resource-bundle>messages.ReStudioCoreBundle</resource-bundle>

  <extensionPoints>
    <extensionPoint qualifiedName="dev.restudio.core.toolProvider" interface="dev.restudio.core.sdk.ToolProvider" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="dev.restudio.core">
    <toolProvider implementation="dev.restudio.core.sdk.SdkToolProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <editorNotificationProvider implementation="dev.restudio.core.ide.FilteredLanguageServerSuggestionProvider"/>
    <postStartupActivity implementation="dev.restudio.core.ide.LanguageServerSuggestionFilterActivity"/>
    <applicationConfigurable parentId="tools"
                             id="dev.restudio.tools"
                             key="tools.settings.title"
                             instance="dev.restudio.core.sdk.ToolsConfigurable"/>
    <notificationGroup id="ReStudio" displayType="BALLOON" key="notification.group.restudio"/>
    <statusBarWidgetFactory id="dev.restudio.LanguageServerStatus"
                            implementation="dev.restudio.core.lsp.LanguageServerStatusWidgetFactory"/>
  </extensions>

  <actions>
    <action id="dev.restudio.OpenLspTrace" class="dev.restudio.core.lsp.OpenLspTraceAction">
      <add-to-group group-id="HelpDiagnosticTools"/>
    </action>
  </actions>
</idea-plugin>
