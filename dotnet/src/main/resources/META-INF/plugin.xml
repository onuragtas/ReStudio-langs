<idea-plugin>
  <id>dev.restudio.dotnet</id>
  <name>ReStudio .NET</name>
  <vendor>ReStudio</vendor>
  <description><![CDATA[
    C# and .NET support through Roslyn LS and netcoredbg: code insight, run and debug gutter icons for
    the program entry point and the tests, and a test tree for <code>dotnet test</code>.
  ]]></description>

  <resource-bundle>messages.DotnetBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>
  <depends>dev.restudio.core</depends>
  <depends>org.jetbrains.plugins.textmate</depends>

  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="restudio.roslyn"
            name="Roslyn LS (ReStudio)"
            factoryClass="dev.restudio.dotnet.lsp.RoslynServerFactory"/>
    <fileNamePatternMapping patterns="*.cs"
                            serverId="restudio.roslyn"
                            languageId="csharp"/>
    <debugAdapterServer id="restudio.netcoredbg"
                        name="netcoredbg (ReStudio)"
                        factoryClass="dev.restudio.dotnet.debug.NetcoredbgDescriptorFactory"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <!-- The platform maps *.cs to its built-in "C#" custom file type (defaultFileTypes.xml), whose language is TEXT.
         A *.csx or *.cake file goes to TextMate. -->
    <codeInsight.lineMarkerProvider language="TEXT"
                                    implementationClass="dev.restudio.dotnet.run.CSharpLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="textmate"
                                    implementationClass="dev.restudio.dotnet.run.CSharpLineMarkerProvider"/>
    <configurationType implementation="dev.restudio.dotnet.run.DotnetRunConfigurationType"/>
    <configurationType implementation="dev.restudio.dotnet.test.DotnetTestConfigurationType"/>
    <configurationType implementation="dev.restudio.dotnet.debug.DotnetAttachConfigurationType"/>
    <xdebugger.attachDebuggerProvider implementation="dev.restudio.dotnet.debug.DotnetAttachDebuggerProvider"/>
    <runConfigurationProducer implementation="dev.restudio.dotnet.run.DotnetRunConfigurationProducer"/>
    <runConfigurationProducer implementation="dev.restudio.dotnet.test.DotnetTestRunConfigurationProducer"/>
    <stepsBeforeRunProvider implementation="dev.restudio.dotnet.run.DotnetBuildBeforeRunTaskProvider"/>
    <stepsBeforeRunProvider implementation="dev.restudio.dotnet.test.DotnetTestHostBeforeRunTaskProvider"/>
    <notificationGroup id="ReStudio .NET" displayType="BALLOON"/>
    <pluginAdvertiserSuppressor implementation="dev.restudio.dotnet.ide.DotnetAdvertiserSuppressor"/>
  </extensions>

  <actions>
    <!-- The IDs are the Roslyn LS code lens commands. LSP4IJ runs the action with the same ID. -->
    <action id="dotnet.test.run" class="dev.restudio.dotnet.lsp.DotnetTestRunCommandAction"/>
    <action id="roslyn.client.peekReferences" class="dev.restudio.dotnet.lsp.RoslynPeekReferencesCommandAction"/>
  </actions>
</idea-plugin>
