<idea-plugin>
  <id>dev.restudio.spring</id>
  <name>ReStudio Spring</name>
  <vendor>ReStudio</vendor>
  <description><![CDATA[
    Spring and Spring Boot support on the Java code model: a bean model, autowiring inspections,
    gutter navigation between beans and injection points, <code>application.properties</code> and
    <code>application.yml</code> completion, and a Spring Boot run configuration.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>
  <depends>com.intellij.properties</depends>
  <depends>org.jetbrains.plugins.yaml</depends>

  <resource-bundle>messages.SpringBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <localInspection language="JAVA"
                     shortName="RestudioSpringAutowiring"
                     key="inspection.autowiring.name"
                     groupKey="inspection.group"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="dev.restudio.spring.inspection.SpringAutowiringInspection"/>
    <codeInsight.lineMarkerProvider language="JAVA"
                                    implementationClass="dev.restudio.spring.navigation.SpringLineMarkerProvider"/>

    <completion.contributor language="Properties" order="first"
                            implementationClass="dev.restudio.spring.boot.ConfigCompletionContributor"/>
    <completion.contributor language="yaml" order="first"
                            implementationClass="dev.restudio.spring.boot.ConfigCompletionContributor"/>
    <localInspection language="Properties"
                     shortName="RestudioSpringBootPropertiesKey"
                     key="inspection.config.name"
                     groupKey="inspection.group"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="dev.restudio.spring.boot.ConfigKeyInspection"/>
    <localInspection language="yaml"
                     shortName="RestudioSpringBootYamlKey"
                     key="inspection.config.yaml.name"
                     groupKey="inspection.group"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="dev.restudio.spring.boot.YamlConfigKeyInspection"/>
    <lang.documentationProvider language="Properties" order="first"
                                implementationClass="dev.restudio.spring.boot.ConfigDocumentationProvider"/>
    <lang.documentationProvider language="yaml" order="first"
                                implementationClass="dev.restudio.spring.boot.ConfigDocumentationProvider"/>
    <gotoDeclarationHandler implementation="dev.restudio.spring.boot.ConfigGotoDeclarationHandler"/>

    <configurationType implementation="dev.restudio.spring.boot.run.SpringBootConfigurationType"/>
    <runConfigurationProducer implementation="dev.restudio.spring.boot.run.SpringBootRunConfigurationProducer"/>
    <runConfigurationExtension implementation="dev.restudio.spring.boot.run.SpringBootRunConfigurationExtension"/>
  </extensions>
</idea-plugin>
